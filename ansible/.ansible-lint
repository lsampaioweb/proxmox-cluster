---
# common is a shared library role; generic register names (output, result)
# are intentional per the role governance instruction.
# var-naming[no-role-prefix] would require every variable in every task to
# carry a role prefix, which conflicts with the pass-through wrapper design.
# syntax-check[specific] fires on cross-role import_role with tasks_from;
# the paths resolve correctly at runtime via roles_path = roles in ansible.cfg.
skip_list:
  - "var-naming"
  - "name[template]"
